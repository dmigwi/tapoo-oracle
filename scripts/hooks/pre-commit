#!/bin/sh
# Pre-commit hook for tapoo-oracle.
#
# Runs the checks that are cheap locally and expensive to discover in CI: the type check, lint and the
# test suite. The type check runs first - a type error usually explains the lint findings after it.
# Nothing here reaches the network, so committing never depends on GitHub being available.

set -e

echo "Type-checking..."
if ! pnpm run typecheck; then
    echo ""
    echo "Commit rejected: tsc found type errors."
    echo ""
    exit 1
fi

echo "Running eslint..."
if ! pnpm run lint; then
    echo ""
    echo "Commit rejected: eslint found issues."
    echo "Tip: 'pnpm run lint:fix' auto-fixes some of them."
    echo ""
    exit 1
fi

echo "Running tests..."
if ! pnpm run test; then
    echo ""
    echo "Commit rejected: tests failed."
    echo ""
    exit 1
fi

echo "Pre-commit checks passed - proceeding with commit"
exit 0
