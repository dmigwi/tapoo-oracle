# Observable build output and caches
/dist/
/public/
# Generated by scripts/build.mjs: the staged root Observable builds and previews from.
/staged/
/src/.observablehq/cache/

# Local test workspace: synthetic logs, and whatever writes them, for looking at a report the real capture
# cannot produce. Ignored rather than tracked, and referenced by no script, tsconfig project or lint block -
# the line between production code and local test code is that nothing in the repo knows this exists.
/test-workspace/

.tmp/

